<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Keep Visual Studio/WebDeploy restores aligned with the existing win-x86 publish profiles. -->
    <RuntimeIdentifiers>win-x86;win-x64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>logicfit-api-secrets</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.20" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="8.0.10" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="8.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.2" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
    <PackageReference Include="StackExchange.Redis" Version="2.8.24" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LogicFit.Application\LogicFit.Application.csproj" />
    <ProjectReference Include="..\LogicFit.Infrastructure\LogicFit.Infrastructure.csproj" />
    <!-- Keep both migration assemblies in the published API so provisioning can select the
         correct history without loading the legacy shared-context migrations. -->
    <ProjectReference Include="..\LogicFit.Platform.Migrations\LogicFit.Platform.Migrations.csproj" />
    <ProjectReference Include="..\LogicFit.Tenant.Migrations\LogicFit.Tenant.Migrations.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\LogicFit.Infrastructure\Persistence\SeedData\*.json" CopyToOutputDirectory="PreserveNewest" LinkBase="SeedData" />
    <Content Update="appsettings.Production.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
